{
  "name": "access-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An LLM gateway over a multi-tenant access-control system, with guardrails against indirect prompt injection and cross-tenant data exposure.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:adversarial": "vitest run tests/adversarial",
    "db:up": "docker compose up -d db",
    "db:reset": "docker compose exec -T db psql -U postgres -d access < db/schema.sql && docker compose exec -T db psql -U postgres -d access < db/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "license": "Apache-2.0"
}
